{
  "name": "meketrefes-del-deporte-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Demo conceptual independiente de un portal web para Meketrefes del Deporte (Panamá).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
